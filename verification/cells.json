    {"id": "drawn-active-fin-extension", "kind": "drc_inject_box", "base_cell": "INVx1_A7S_75t_R", "layer": [2, 0], "box_dbu": [0, 112, 648, 140], "expect_rule": "ACTIVE.FIN.EX.1", "note": "A 7 nm fin at y 28-35 nm, 1 nm above the NMOS ACTIVE bottom edge (y 27 nm), so ACTIVE extends 1 nm past it instead of the 10 nm minimum. In the clean cell the outer fins sit exactly 10 nm inside ACTIVE, so this rule is on its limit there."},
    {"id": "drawn-active-spacing", "kind": "drc_inject_box", "base_cell": "INVx1_A7S_75t_R", "layer": [11, 0], "box_dbu": [200, 608, 440, 628], "expect_rule": "ACTIVE.S.1", "note": "A 60 x 5 nm ACTIVE island at y 152-157 nm, 5 nm below the PMOS ACTIVE (y 162 nm), under the 27 nm vertical ACTIVE spacing. Placed inside the WELL so it does not also trip the ACTIVE-to-WELL separation that drawn-active-well-spacing targets."},
    {"id": "drawn-active-well-spacing", "kind": "drc_inject_box", "base_cell": "INVx1_A7S_75t_R", "layer": [11, 0], "box_dbu": [200, 460, 440, 500], "expect_rule": "ACTIVE.WELL.S.4", "note": "A 60 x 10 nm ACTIVE island at y 115-125 nm in the gap between the NMOS ACTIVE and the WELL, 10 nm below the WELL edge (y 135 nm), under the 27 nm ACTIVE-to-WELL spacing."},
    {"id": "drawn-active-hole", "kind": "drc_inject_box", "base_cell": "INVx1_A7S_75t_R", "layer": [11, 0], "boxes_dbu": [[200, 452, 250, 532], [350, 452, 400, 532], [250, 452, 350, 478], [250, 506, 350, 532]], "expect_rule": "ACTIVE.A.1B", "note": "Four ACTIVE boxes forming a ring (outer x 50-100 nm, y 113-133 nm) around an enclosed 25 x 7 nm hole = 175 nm2, under the 864 nm2 minimum enclosed ACTIVE area. Needs `boxes_dbu`: the rule measures a hole, and one convex box can never enclose a void."},
    {"id": "drawn-active-sd-spacing", "kind": "drc_inject_box", "base_cell": "INVx1_A7S_75t_R", "layer": [11, 0], "box_dbu": [484, 108, 620, 432], "expect_rule": "ACTIVE.S.2A", "note": "A second NMOS source/drain ACTIVE region at x 121-155 nm overlapping the right GATE (so it is a transistor ACTIVE the rule sees), 5 nm from the cell's ACTIVE right edge (x 116 nm) across a gap no ACTIVE covers, and 1 nm clear of the right SDT (x 120 nm) so it connects to nothing and is a different net - under the 92 nm different-net horizontal spacing. The clean cell is silent because the only ACTIVE pair that close is the two sides of one gate, which the rule's not_overlapping(active) filter drops."},
    {"id": "drawn-gate-active-extension", "kind": "drc_inject_box", "base_cell": "INVx1_A7S_75t_R", "layer": [11, 0], "box_dbu": [284, 960, 364, 1000], "expect_rule": "GATE.ACTIVE.EX.1", "note": "An ACTIVE box merging with the PMOS ACTIVE and carrying its top edge up to y 250 nm, leaving the middle GATE (top y 252 nm, wholly uncut by GCUT) only 2 nm of vertical extension past ACTIVE instead of the 4 nm minimum."},
    {"id": "drawn-fin-bend", "kind": "drc_inject_box", "base_cell": "INVx1_A7S_75t_R", "layer": [2, 0], "box_dbu": [100, 176, 200, 204], "expect_rule": "FIN.AUX.1", "note": "A 25 x 7 nm fin box resting directly on the lowest fin (y 37-44 nm), so the merged FIN polygon is an L and is no longer a rectangle."},
    {"id": "drawn-gate-bend", "kind": "drc_inject_box", "base_cell": "INVx1_A7S_75t_R", "layer": [7, 0], "box_dbu": [148, 400, 200, 480], "expect_rule": "GATE.AUX.1", "note": "A 13 x 20 nm GATE box abutting the left gate's right edge (x 37 nm), so the merged GATE polygon bends."},
    {"id": "drawn-gate-isolated", "kind": "drc_inject_box", "base_cell": "INVx1_A7S_75t_R", "layer": [7, 0], "box_dbu": [284, 1020, 364, 1060], "expect_rule": "GATE.S.3", "note": "A 20 nm wide GATE stub at y 255-265 nm, above the y 18-252 nm span the three real gates occupy, so no other GATE projects onto it and it has no horizontal neighbour within 34 nm. There is no room inside the gate row: its 54 nm pitch gives every in-row gate a neighbour 34 nm away."},
